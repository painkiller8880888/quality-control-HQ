<service>
  <id>QualityControlHQ-Worker-Pseudoprod</id>
  <name>Quality Control HQ Worker Pseudoprod</name>
  <description>Persistent PostgreSQL-backed Quality Control HQ job worker.</description>
  <executable>REPLACE_WITH_REPO_DIR\.venv\Scripts\python.exe</executable>
  <arguments>manage.py run_job_worker --poll-seconds 2</arguments>
  <workingdirectory>REPLACE_WITH_REPO_DIR\backend</workingdirectory>
  <env name="DJANGO_ENV_FILE" value="REPLACE_WITH_REPO_DIR\deployment\pseudoprod\.env" />
  <depend>postgresql-x64-18</depend>
  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
