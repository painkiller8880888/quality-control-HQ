APP_ENV=pseudoprod
APP_VERSION=replace-with-release-id
APP_PUBLIC_URL=http://replace-with-current-pc-dns-name:8080

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=use-the-same-value-as-the-runtime-environment
DJANGO_ALLOWED_HOSTS=replace-with-current-pc-dns-name,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://replace-with-current-pc-dns-name:8080

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=quality_prodlike
DB_USER=quality_prodlike_migrator
DB_PASSWORD=replace-with-pseudoprod-migration-password

SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
ALLOW_INSECURE_HTTP=true
HTTP_RISK_ACCEPTANCE_ID=IFC20260716-001
HTTP_RISK_ACCEPTANCE_EXPIRES=2027-07-16
